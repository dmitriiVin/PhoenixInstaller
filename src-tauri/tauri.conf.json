{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Windows Installer",
  "version": "0.1.0",
  "identifier": "com.windowsinstaller.desktop",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Windows Installer",
        "width": 1100,
        "height": 760
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "resources": {
      "../assets/": "assets/",
      "../bcd-sys-2.4-x86_64.AppImage": "bcd-sys-2.4-x86_64.AppImage",
      "../ms-sys": "ms-sys"
    }
  }
}
